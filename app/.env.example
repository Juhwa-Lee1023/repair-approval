# Server-only settings. Never expose these to the browser.
# Default location for the PayPal values: ../private/paypal-sandbox.env (override with PAYPAL_ENV_FILE).

# PayPal Developer > Apps & Credentials > Sandbox REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional
# PORT=8879
# PUBLIC_BASE_URL=http://127.0.0.1:8879   # used for PayPal return/cancel links
# DATA_DIR=./var
# CUSTOMER_LINK_DAYS=7
# AI_PROVIDER=claude-cli                  # or "off"
# AI_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_MS=45000

# There is no setting for the PayPal API host. It is fixed to the Sandbox.
